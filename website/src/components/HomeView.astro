---
import { HERO_VIDEOS } from '../data/catalog'
import { COPY, type Lang } from '../data/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = COPY[lang]
const prefix = lang === 'zh' ? '/zh' : ''
const pluginsHref = `${prefix}/plugins/`
---

<!-- ================= 00 HERO ================= -->
<section class="hero-stage">
  <div class="hero-screen-col">
    <div class="hero-media-wrap" id="hero-media-wrap" transition:persist="hero-tv-media">
      <div class="hero-spill" id="hero-spill" aria-hidden="true">
        <img src="/images/cinema-home.jpg" alt="" class="spill-base" />
        <canvas id="hero-spill-canvas" width="64" height="36"></canvas>
      </div>

      <div class="hero-tv-frame" id="hero-tv-frame">
        <img
          src="/images/cinema-home.jpg"
          alt="MikuTV on Apple TV 4K"
          class="hero-tv-poster"
        />
        {HERO_VIDEOS.map((clip, index) => (
          <video
            class:list={['hero-tv-video', { 'is-active': index === 0 }]}
            data-hero-slot={index}
            data-clip-id={clip.id}
            data-src={clip.src}
            data-initial-start={clip.initialStart}
            data-loop-start={clip.loopStart}
            src={index === 0 ? `${clip.src}#t=${clip.initialStart}` : undefined}
            autoplay={index === 0}
            muted
            playsinline
            preload={index === 0 ? 'auto' : 'none'}
          ></video>
        ))}
      </div>
    </div>

    <div class="hero-tv-caption">
      <span class="mono">{t.hero.screenLabel}</span>
      <button
        type="button"
        class="sound-toggle"
        id="hero-sound-btn"
        aria-pressed="false"
        data-label-off={t.hero.soundOff}
        data-label-on={t.hero.soundOn}
      >
        {t.hero.soundOff}
      </button>
    </div>
  </div>

  <div class="hero-copy-col">
    <h1 class="display-title">
      {t.hero.titleLines[0]}{' '}
      <br />
      {t.hero.titleLines[1]}
    </h1>
    <p class="hero-lead">{t.hero.lead}</p>
    <div class="hero-actions">
      <a href="#install" class="action-solid">{t.hero.ctaPrimary}</a>
      <a href={pluginsHref} class="action-link">{t.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<!-- ================= 01 STATEMENT ================= -->
<section class="band">
  <div class="rule-top">
    <div class="grid-12">
      <div class="statement-prose">
        {t.statement.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </div>
</section>

<!-- ================= 02 ONE EVENING ================= -->
<!-- 18:12 Home Screen -->
<section class="moment">
  <div class="moment__rule">
    <span class="mono">{t.evening.m1.time}</span>
    <span class="mono">{t.evening.m1.label}</span>
  </div>
  <div class="moment__grid">
    <div class="moment__text">
      <h2 class="moment__title">{t.evening.m1.title}</h2>
      {t.evening.m1.body.map((p) => <p class="moment__body">{p}</p>)}
    </div>
    <div class="moment__screen">
      <img
        src="/images/tvos-home-icon.jpg"
        alt="MikuTV on the Apple TV Home Screen top row with Top Shelf"
      />
    </div>
  </div>
</section>

<!-- 18:47 Sunset Diagonal Wipe -->
<section class="moment">
  <div class="moment__rule">
    <span class="mono">{t.evening.m2.time}</span>
    <span class="mono">{t.evening.m2.label}</span>
  </div>
  <div class="moment__grid">
    <div class="moment__text">
      <h2 class="moment__title">{t.evening.m2.title}</h2>
      {t.evening.m2.body.map((p) => <p class="moment__body">{p}</p>)}
    </div>
    <div class="moment__screen">
      <div class="sunset-wipe" id="sunset-wipe">
        <img src="/images/theme-picker-dark.jpg" alt="MikuTV dark theme drawer on Apple TV 4K" />
        <img
          src="/images/theme-picker-light.jpg"
          alt="MikuTV light theme drawer on Apple TV 4K"
          class="sunset-wipe__light"
          id="sunset-wipe-light"
        />
      </div>
    </div>
  </div>
</section>

<!-- 19:30 Sit Down — Offset Layered Frames -->
<section class="moment">
  <div class="moment__rule">
    <span class="mono">{t.evening.m3.time}</span>
    <span class="mono">{t.evening.m3.label}</span>
  </div>
  <div class="moment__grid">
    <div class="moment__text">
      <h2 class="moment__title">{t.evening.m3.title}</h2>
      {t.evening.m3.body.map((p) => <p class="moment__body">{p}</p>)}
    </div>
    <div class="screen-overlap">
      <div class="screen-overlap__back">
        <img src="/images/cinema-home.jpg" alt="MikuTV Home Hero focus on Apple TV 4K" />
      </div>
      <div class="screen-overlap__front">
        <img src="/images/cinema-wall.jpg" alt="MikuTV media library poster grid on Apple TV 4K" />
      </div>
    </div>
  </div>
</section>

<!-- 21:04 Playback — Full-Bleed Frame -->
<section class="moment-fullbleed">
  <div class="moment-fullbleed__head">
    <div class="rule-top" style="margin-bottom:28px;display:flex;justify-content:space-between;">
      <span class="mono">{t.evening.m4.time}</span>
      <span class="mono">{t.evening.m4.label}</span>
    </div>
    <div class="moment-fullbleed__copy">
      <h2 class="moment__title">{t.evening.m4.title}</h2>
      {t.evening.m4.body.map((p) => <p class="moment__body">{p}</p>)}
    </div>
  </div>
  <div class="fullbleed-frame">
    <img src="/images/cinema-playback.jpg" alt="MikuTV hardware AVPlayer playback with subtitles on Apple TV 4K" />
  </div>
</section>

<!-- ================= 03 THEN YOU FILL IT ================= -->
<section class="moment">
  <div class="moment__rule">
    <span class="mono">{t.fill.label}</span>
    <span class="mono">TOPIC:MIKUTV-PLUGIN</span>
  </div>
  <div class="moment__grid">
    <div class="fill-left">
      <h2 class="moment__title">{t.fill.title}</h2>
      {t.fill.body.map((p) => <p class="moment__body">{p}</p>)}

      <div class="ledger ledger--interactive">
        {t.fill.rows.map((r) => (
          <a href={pluginsHref} class="ledger-row">
            <span class="ledger-row__k">{r.k}</span>
            <span class="ledger-row__v">{r.v}</span>
          </a>
        ))}
      </div>

      <div style="margin-top:26px;">
        <a href={pluginsHref} class="action-link">{t.fill.link}</a>
      </div>
    </div>

    <div class="fill-right">
      <img src="/images/plugin-discover-themes.jpg" alt="MikuTV plugin discovery screen on Apple TV 4K" />
    </div>
  </div>
</section>

<!-- ================= 04 SPECIFICATION NAMEPLATE ================= -->
<section class="band">
  <div class="rule-top">
    <div class="grid-12">
      <div class="spec-plate">
        <div class="mono" style="margin-bottom:14px;">{t.build.label}</div>
        <h2 class="moment__title" style="font-size:clamp(1.6rem,2.6vw,2.3rem);">{t.build.title}</h2>
        <p class="moment__body">{t.build.lead}</p>
        <dl class="spec-plate__list">
          {t.build.rows.map((r) => (
            <div class="spec-plate__row">
              <dt>{r.k}</dt>
              <dd>{r.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="nameplate-pair">
        <figure>
          <img src="/images/about-dark.jpg" alt="MikuTV About screen in Tokyo Night" />
          <figcaption class="mono">{t.build.darkCap}</figcaption>
        </figure>
        <figure>
          <img src="/images/about-light.jpg" alt="MikuTV About screen in Rosé Pine Dawn" />
          <figcaption class="mono">{t.build.lightCap}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<!-- ================= 05 INSTALLATION ================= -->
<section class="band" id="install">
  <div class="rule-top">
    <div class="grid-12">
      <div class="install-left">
        <div class="mono" style="margin-bottom:14px;">{t.install.label}</div>
        <h2 class="moment__title">{t.install.title}</h2>
        {t.install.body.map((p) => <p class="moment__body">{p}</p>)}
        <p class="mono" style="margin-top:24px;">{t.install.req}</p>
      </div>

      <div class="install-right">
        <div class="file-ledger">
          {t.install.files.map((f) => (
            <a href={f.href} target="_blank" rel="noopener noreferrer" class="file-row">
              <span class="file-row__name">{f.name}</span>
              <span class="file-row__note">{f.note}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= 06 CLOSING ================= -->
<section class="closing">
  <p class="display-title">{t.closing}</p>
</section>

<script>
  interface HeroController {
    bindSoundButton: (btn: HTMLButtonElement | null) => void
    resume: () => void
    onVisibilityChange: () => void
    dispose: () => void
  }

  const heroControllers = new WeakMap<HTMLElement, HeroController>()
  let mountedHeroWrap: HTMLElement | null = null
  let globalHeroListenersBound = false

  function ensureGlobalHeroListeners() {
    if (globalHeroListenersBound) return
    globalHeroListenersBound = true
    document.addEventListener('visibilitychange', () => {
      if (!mountedHeroWrap) return
      if (!mountedHeroWrap.isConnected) {
        heroControllers.get(mountedHeroWrap)?.dispose()
        mountedHeroWrap = null
        return
      }
      heroControllers.get(mountedHeroWrap)?.onVisibilityChange()
    })
    document.addEventListener('astro:after-swap', () => {
      if (mountedHeroWrap && !mountedHeroWrap.isConnected) {
        heroControllers.get(mountedHeroWrap)?.dispose()
        mountedHeroWrap = null
      }
    })
  }

  function createHeroController(wrap: HTMLElement): HeroController {
    const frame = wrap.querySelector<HTMLElement>('#hero-tv-frame')
    const spill = wrap.querySelector<HTMLElement>('#hero-spill')
    const spillCanvas = wrap.querySelector<HTMLCanvasElement>('#hero-spill-canvas')
    const spillCtx = spillCanvas?.getContext('2d', { alpha: false }) ?? null
    const videos = Array.from(wrap.querySelectorAll<HTMLVideoElement>('video[data-hero-slot]'))
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    let activeIndex = 0
    let pendingIndex: number | null = null
    let soundEnabled = false
    let initialRevealed = false
    let preloadScheduled = false
    let switchGen = 0
    let rafId = 0
    let lastSpillDraw = 0
    let soundBtn: HTMLButtonElement | null = null
    const retryCounts = videos.map(() => 0)

    const getInitialStart = (index: number): number =>
      Number(videos[index]?.dataset.initialStart || 0) || 0

    const getLoopStart = (index: number): number =>
      Number(videos[index]?.dataset.loopStart || 0) || 0

    const syncSoundButton = () => {
      if (!soundBtn) return
      soundBtn.setAttribute('aria-pressed', String(soundEnabled))
      soundBtn.textContent = soundEnabled
        ? soundBtn.dataset.labelOn || 'SOUND ON'
        : soundBtn.dataset.labelOff || 'SOUND OFF'
    }

    const drawSpillFrame = (vid: HTMLVideoElement | undefined) => {
      if (!spillCanvas || !spillCtx || !vid || vid.readyState < 2 || vid.videoWidth === 0) return
      try {
        spillCtx.drawImage(vid, 0, 0, spillCanvas.width, spillCanvas.height)
        if (!spillCanvas.classList.contains('is-ready')) {
          spillCanvas.classList.add('is-ready')
          spill?.classList.add('has-video')
        }
      } catch {
        // Ignore transient decode frame errors
      }
    }

    const stopSpillLoop = () => {
      if (rafId) {
        window.cancelAnimationFrame(rafId)
        rafId = 0
      }
    }

    const startSpillLoop = () => {
      if (reducedMotion || !spillCtx || rafId || document.hidden || !wrap.isConnected) return
      const tick = (now: number) => {
        if (!wrap.isConnected || document.hidden) {
          rafId = 0
          return
        }
        if (now - lastSpillDraw >= 50) {
          lastSpillDraw = now
          const activeVid = videos[activeIndex]
          if (activeVid && activeVid.classList.contains('is-ready')) {
            drawSpillFrame(activeVid)
          }
        }
        rafId = window.requestAnimationFrame(tick)
      }
      rafId = window.requestAnimationFrame(tick)
    }

    const handleVisibilityChange = () => {
      if (!wrap.isConnected) {
        stopSpillLoop()
        return
      }
      if (document.hidden) {
        stopSpillLoop()
      } else {
        startSpillLoop()
      }
    }

    const ensureLoaded = (index: number) => {
      const vid = videos[index]
      if (!vid || vid.dataset.loaded === '1') return
      const rawSrc = vid.dataset.src
      if (!rawSrc) return
      vid.dataset.loaded = '1'
      vid.preload = 'auto'
      vid.src = rawSrc
      vid.load()
    }

    const schedulePreloadNext = () => {
      if (preloadScheduled || videos.length < 2) return
      preloadScheduled = true
      window.setTimeout(() => {
        if (!wrap.isConnected || reducedMotion) return
        ensureLoaded((activeIndex + 1) % videos.length)
      }, 1500)
    }

    const promoteActive = (nextIndex: number, prevIndex: number) => {
      const prevVid = videos[prevIndex]
      const nextVid = videos[nextIndex]
      if (!nextVid) return

      activeIndex = nextIndex
      nextVid.volume = 1
      nextVid.muted = !soundEnabled
      nextVid.classList.add('is-active', 'is-ready')
      if (!initialRevealed) {
        initialRevealed = true
        window.setTimeout(() => {
          if (wrap.isConnected) frame?.classList.add('has-video')
        }, 650)
      }
      drawSpillFrame(nextVid)
      startSpillLoop()

      if (prevVid && prevVid !== nextVid) {
        prevVid.muted = true
        prevVid.classList.remove('is-active')
        window.setTimeout(() => {
          if (activeIndex === prevIndex || pendingIndex === prevIndex || !wrap.isConnected) return
          prevVid.pause()
          prevVid.muted = true
          const rewindTarget = getLoopStart(prevIndex)
          if (prevVid.readyState >= 1) {
            try {
              prevVid.currentTime = rewindTarget
            } catch {
              // ignore rewind error
            }
          }
        }, 240)
      }

      if (videos.length > 1) {
        ensureLoaded((nextIndex + 1) % videos.length)
      }
      syncSoundButton()
    }

    const unlockForSound = (slotIndex: number) => {
      const vid = videos[slotIndex]
      if (!vid || vid.dataset.soundUnlocked === '1') return
      ensureLoaded(slotIndex)
      vid.volume = 0
      vid.muted = false
      const playPromise = vid.play()
      if (playPromise && typeof playPromise.then === 'function') {
        playPromise
          .then(() => {
            if (activeIndex !== slotIndex && pendingIndex !== slotIndex) {
              vid.pause()
              const target = getLoopStart(slotIndex)
              if (vid.readyState >= 1) {
                try {
                  vid.currentTime = target
                } catch {
                  // ignore before seekable
                }
              }
            }
            vid.volume = 1
            vid.muted = !soundEnabled || (activeIndex !== slotIndex && pendingIndex !== slotIndex)
            vid.dataset.soundUnlocked = '1'
          })
          .catch(() => {
            vid.volume = 1
            vid.muted = true
          })
      }
    }

    const refreshClip = (index: number, playWhenReady: boolean) => {
      const vid = videos[index]
      const rawSrc = vid?.dataset.src
      if (!vid || !rawSrc) return
      retryCounts[index] += 1
      if (retryCounts[index] > 2) {
        if (playWhenReady && videos.length > 1) {
          const fallbackIndex = (index + 1) % videos.length
          if (retryCounts[fallbackIndex] <= 2) {
            void switchTo(fallbackIndex)
          }
        }
        return
      }
      const target =
        index === 0 && vid.dataset.initialSeekDone !== '1'
          ? getInitialStart(index)
          : getLoopStart(index)
      vid.dataset.loaded = '1'
      vid.dataset.pendingSeek = String(target)
      vid.preload = 'auto'
      vid.src = target > 0 ? `${rawSrc}#t=${target}` : rawSrc
      vid.load()
      if (playWhenReady) {
        const gen = ++switchGen
        const prevIndex = activeIndex
        pendingIndex = index
        vid.volume = 1
        vid.muted = !soundEnabled
        vid
          .play()
          .then(() => {
            if (gen === switchGen && wrap.isConnected) {
              pendingIndex = null
              promoteActive(index, prevIndex)
            }
          })
          .catch(() => {
            if (gen !== switchGen) return
            if (!vid.muted) {
              soundEnabled = false
              vid.muted = true
              syncSoundButton()
              vid
                .play()
                .then(() => {
                  if (gen === switchGen && wrap.isConnected) {
                    pendingIndex = null
                    promoteActive(index, prevIndex)
                  }
                })
                .catch(() => {
                  if (gen === switchGen) pendingIndex = null
                })
            } else {
              pendingIndex = null
            }
          })
      }
    }

    const switchTo = async (nextIndex: number) => {
      if (!wrap.isConnected || reducedMotion || videos.length === 0) return
      const gen = ++switchGen
      const prevIndex = activeIndex
      const prevVid = videos[prevIndex]
      const nextVid = videos[nextIndex]
      if (!nextVid) return

      pendingIndex = nextIndex
      ensureLoaded(nextIndex)

      const targetStart = getLoopStart(nextIndex)
      if (nextVid.readyState >= 1) {
        if (Math.abs(nextVid.currentTime - targetStart) > 0.15) {
          try {
            nextVid.currentTime = targetStart
          } catch {
            // ignore seek error before seekable
          }
        }
      } else {
        nextVid.dataset.pendingSeek = String(targetStart)
      }

      if (prevVid && prevVid !== nextVid) {
        prevVid.muted = true
      }

      nextVid.volume = 1
      nextVid.muted = !soundEnabled

      let started = false
      try {
        await nextVid.play()
        started = true
      } catch {
        if (gen !== switchGen) return
        if (!nextVid.muted) {
          soundEnabled = false
          nextVid.muted = true
          syncSoundButton()
          try {
            await nextVid.play()
            started = true
          } catch {
            started = false
          }
        }
      }

      if (gen !== switchGen || !wrap.isConnected) {
        if (started && activeIndex !== nextIndex) {
          nextVid.pause()
          nextVid.muted = true
        }
        return
      }

      pendingIndex = null

      if (!started) {
        refreshClip(nextIndex, true)
        return
      }

      promoteActive(nextIndex, prevIndex)
    }

    if (reducedMotion) {
      for (const vid of videos) {
        vid.pause()
      }
    } else if (videos.length > 0) {
      const firstVid = videos[0]
      firstVid.dataset.loaded = '1'
      const firstInitialStart = getInitialStart(0)

      const ensureFirstLitStart = () => {
        if (firstVid.dataset.initialSeekDone === '1') return
        if (firstVid.duration && firstVid.duration > firstInitialStart) {
          if (firstVid.currentTime < firstInitialStart - 0.5) {
            try {
              firstVid.currentTime = firstInitialStart
            } catch {
              return
            }
          }
          if (firstVid.currentTime >= firstInitialStart - 0.5) {
            firstVid.dataset.initialSeekDone = '1'
          }
        }
      }

      const revealFirstWhenLit = () => {
        if (initialRevealed || activeIndex !== 0) return
        if (firstVid.readyState >= 2 && firstVid.currentTime >= firstInitialStart - 0.5) {
          firstVid.dataset.initialSeekDone = '1'
          initialRevealed = true
          firstVid.classList.add('is-ready')
          drawSpillFrame(firstVid)
          startSpillLoop()
          schedulePreloadNext()
          window.setTimeout(() => {
            if (wrap.isConnected) {
              frame?.classList.add('has-video')
            }
          }, 650)
        }
      }

      videos.forEach((vid, index) => {
        vid.addEventListener('loadedmetadata', () => {
          if (index === 0 && vid.dataset.initialSeekDone !== '1') {
            ensureFirstLitStart()
          }
          if (vid.dataset.pendingSeek !== undefined) {
            const target = Number(vid.dataset.pendingSeek)
            delete vid.dataset.pendingSeek
            if (!Number.isNaN(target) && vid.duration && target < vid.duration) {
              try {
                vid.currentTime = target
              } catch {
                // ignore seek error
              }
            }
          }
        })

        vid.addEventListener('canplay', () => {
          if (index === 0 && vid.dataset.initialSeekDone !== '1') {
            ensureFirstLitStart()
          }
        })

        vid.addEventListener('playing', () => {
          retryCounts[index] = 0
          if (index === 0) {
            revealFirstWhenLit()
          }
          if (index === activeIndex && (index !== 0 || initialRevealed)) {
            vid.classList.add('is-ready')
            drawSpillFrame(vid)
            startSpillLoop()
          }
        })

        vid.addEventListener('seeked', () => {
          if (index === 0) revealFirstWhenLit()
        })

        vid.addEventListener('timeupdate', () => {
          if (index === 0 && !initialRevealed) {
            revealFirstWhenLit()
          }
        })

        vid.addEventListener('ended', () => {
          if (index !== activeIndex) return
          const nextIndex = (index + 1) % videos.length
          void switchTo(nextIndex)
        })

        vid.addEventListener('error', () => {
          if (vid.dataset.loaded !== '1') return
          refreshClip(index, index === activeIndex)
        })
      })

      if (firstVid.readyState >= 1) ensureFirstLitStart()
      revealFirstWhenLit()
      firstVid.play().catch(() => {})
    }

    return {
      bindSoundButton(btn) {
        soundBtn = btn
        if (!btn || videos.length === 0) return
        syncSoundButton()
        if (btn.dataset.bound === '1') return
        btn.dataset.bound = '1'
        btn.addEventListener('click', () => {
          soundEnabled = !soundEnabled
          const hasPendingHandoff = pendingIndex !== null && pendingIndex !== activeIndex
          const activeVid = videos[activeIndex]
          if (activeVid) {
            if (hasPendingHandoff || activeVid.ended) {
              activeVid.muted = true
            } else {
              activeVid.volume = 1
              activeVid.muted = !soundEnabled
              if (activeVid.paused && !reducedMotion) {
                activeVid.play().catch(() => {})
              }
            }
          }
          if (soundEnabled) {
            if (hasPendingHandoff && pendingIndex !== null) {
              const pendingVid = videos[pendingIndex]
              if (pendingVid) {
                pendingVid.volume = 1
                pendingVid.muted = false
              }
            }
            videos.forEach((_, idx) => {
              if (idx !== activeIndex && idx !== pendingIndex) {
                unlockForSound(idx)
              }
            })
          } else {
            videos.forEach((vid) => {
              vid.muted = true
            })
          }
          syncSoundButton()
        })
      },
      resume() {
        if (reducedMotion || !wrap.isConnected) return
        if (pendingIndex !== null && pendingIndex !== activeIndex) {
          startSpillLoop()
          return
        }
        const activeVid = videos[activeIndex]
        if (activeVid && activeVid.paused && !activeVid.ended) {
          activeVid.play().catch(() => {})
        }
        startSpillLoop()
      },
      onVisibilityChange: handleVisibilityChange,
      dispose() {
        switchGen += 1
        pendingIndex = null
        soundBtn = null
        stopSpillLoop()
        for (const vid of videos) {
          vid.pause()
          vid.muted = true
        }
      },
    }
  }

  function initHome() {
    ensureGlobalHeroListeners()
    const wrap = document.getElementById('hero-media-wrap')
    const soundBtn = document.getElementById('hero-sound-btn') as HTMLButtonElement | null

    if (mountedHeroWrap && mountedHeroWrap !== wrap && !mountedHeroWrap.isConnected) {
      heroControllers.get(mountedHeroWrap)?.dispose()
      mountedHeroWrap = null
    }

    if (wrap) {
      mountedHeroWrap = wrap
      let controller = heroControllers.get(wrap)
      if (!controller) {
        controller = createHeroController(wrap)
        heroControllers.set(wrap, controller)
      }
      controller.bindSoundButton(soundBtn)
      controller.resume()
    }

    // Sunset diagonal wipe interactive scrub (complements scroll-driven CSS animation)
    const wipe = document.getElementById('sunset-wipe')
    const wipeLight = document.getElementById('sunset-wipe-light')
    if (wipe && wipeLight && !wipe.dataset.bound) {
      wipe.dataset.bound = '1'
      const setDiagonal = (ratio: number) => {
        const p = Math.max(0.06, Math.min(0.94, ratio))
        const topX = Math.round((p + 0.14) * 100)
        const botX = Math.round((p - 0.14) * 100)
        wipe.classList.add('is-scrubbed')
        wipeLight.style.clipPath = `polygon(0 0, ${topX}% 0, ${botX}% 100%, 0 100%)`
      }
      let dragging = false
      wipe.addEventListener('pointerdown', (e) => {
        dragging = true
        wipe.setPointerCapture(e.pointerId)
        const r = wipe.getBoundingClientRect()
        setDiagonal((e.clientX - r.left) / r.width)
      })
      wipe.addEventListener('pointermove', (e) => {
        if (!dragging) return
        const r = wipe.getBoundingClientRect()
        setDiagonal((e.clientX - r.left) / r.width)
      })
      wipe.addEventListener('pointerup', () => { dragging = false })
      wipe.addEventListener('pointercancel', () => { dragging = false })
    }
  }

  document.addEventListener('astro:page-load', initHome)
  if (document.readyState !== 'loading') initHome()
</script>
