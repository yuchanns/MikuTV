{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mikutv-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "4fd35fa9c314ee49502c0cc22ac3ab88",
  "routes": [
    {
      "pattern": "mikutv.yuchanns.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
