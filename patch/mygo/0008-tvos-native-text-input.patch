diff --git a/internal/tvos/text_input.go b/internal/tvos/text_input.go
new file mode 100644
--- /dev/null
+++ b/internal/tvos/text_input.go
@@ -0,0 +1,111 @@
+//go:build ios && tvos && arm64
+
+package tvos
+
+import (
+	"math"
+
+	"github.com/ebitengine/purego/objc"
+	"github.com/egoist/mygo/internal/platform"
+)
+
+const textEditingChanged = 1 << 17 // UIControlEventEditingChanged
+
+func (w *window) SetTextInput(state platform.TextInputState) {
+	previous := w.textInput
+	w.textInput = state
+	changed := previous.Client != state.Client
+	if !state.Active || state.NoInputMethod || changed {
+		w.removeTextField()
+	}
+	if !previous.Active || changed || previous.ShowKeyboard != state.ShowKeyboard {
+		w.showTextField()
+	}
+}
+
+func (w *window) showTextField() bool {
+	state := w.textInput
+	if !state.Active || state.Client == nil || state.NoInputMethod || !w.IsFocused() || w.textField != 0 {
+		return false
+	}
+	value, _ := state.Client.TextForRange(platform.TextRange{End: math.MaxInt32})
+	// UIKit owns the onscreen keyboard. Keep its backing field outside the
+	// drawn surface so MyGo's focused element remains the visible editor.
+	field := native.initRect(send(class("UITextField"), "alloc"), sel("initWithFrame:"), rect{X: -2, Y: -2, Width: 1, Height: 1})
+	w.textField = field
+	send(field, "setDelegate:", w.view)
+	send(field, "setText:", stringID(value))
+	send(field, "setPlaceholder:", stringID(state.Placeholder))
+	send(field, "setSecureTextEntry:", state.Traits.Secure)
+	send(field, "setKeyboardType:", [...]int{0, 7, 4, 8, 5, 3, 10}[state.Traits.Keyboard])
+	send(field, "setReturnKeyType:", [...]int{0, 9, 1, 4, 6, 7}[state.Traits.ReturnKey])
+	if state.Traits.Capitalize != platform.CapitalizeDefault {
+		send(field, "setAutocapitalizationType:", int(state.Traits.Capitalize)-1)
+	}
+	send(field, "setAutocorrectionType:", [...]int{0, 2, 1}[state.Traits.Autocorrect])
+	send(field, "addTarget:action:forControlEvents:", w.view, sel("textFieldChanged:"), textEditingChanged)
+	send(w.view, "addSubview:", field)
+	if !objc.Send[bool](field, sel("becomeFirstResponder")) {
+		w.removeTextField()
+		return false
+	}
+	return true
+}
+
+func (w *window) removeTextField() {
+	if field := w.textField; field != 0 {
+		w.textField = 0
+		send(field, "setDelegate:", id(0))
+		send(field, "removeTarget:action:forControlEvents:", w.view, sel("textFieldChanged:"), textEditingChanged)
+		send(field, "resignFirstResponder")
+		send(field, "removeFromSuperview")
+		// UIKit can still be unwinding this field's delegate callback.
+		send(field, "autorelease")
+		if w.IsFocused() {
+			send(w.view, "becomeFirstResponder")
+		}
+	}
+}
+
+func fieldText(field id) string {
+	return objc.Send[string](send(field, "text"), sel("UTF8String"))
+}
+
+func limitFieldText(value string, maxLength int) string {
+	if maxLength > 0 {
+		return value[:platform.UTF16ByteOffset(value, maxLength)]
+	}
+	return value
+}
+
+func (w *window) limitTextField(field id) {
+	if send(field, "markedTextRange") != 0 {
+		return
+	}
+	value := fieldText(field)
+	if limited := limitFieldText(value, w.textInput.MaxLength); limited != value {
+		send(field, "setText:", stringID(limited))
+	}
+}
+
+func (w *window) finishTextField(field id, reason int) {
+	if field == 0 || w.textField != field {
+		return
+	}
+	state, text := w.textInput, fieldText(field)
+	w.removeTextField()
+
+	const cancelled = 1 // UITextFieldDidEndEditingReasonCancelled
+	key := platform.KeyEscape
+	if reason != cancelled {
+		value := limitFieldText(text, state.MaxLength)
+		key = platform.KeyEnter
+		if client := state.Client; client != nil {
+			if current, all := client.TextForRange(platform.TextRange{End: math.MaxInt32}); current != value {
+				client.ReplaceText(&all, value)
+			}
+		}
+	}
+	w.sendRemoteKey(key, platform.KeyPressed)
+	w.sendRemoteKey(key, platform.KeyReleased)
+}
