+// OnWindowBack handles unmodified Escape and Back after focused controls
+// and registered shortcuts. Register it from the window view. Returning
+// false leaves the event to the system.
+func (c *Context) OnWindowBack(fn func() bool) {
+	if raw := c.build(); raw != nil {
+		raw.rt.windowBack = fn
+	}
+}
