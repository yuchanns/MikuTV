+const (
+	remoteHoldDelay    = 525 * time.Millisecond
+	remoteRepeatSlow   = 125 * time.Millisecond
+	remoteRepeatFast   = 105 * time.Millisecond
+	remoteSpeedUpAfter = 950 * time.Millisecond
+)
+
+type remoteRepeat struct {
+	key          platform.Key
+	next, fastAt time.Time
+}
+
+func (r *remoteRepeat) begin(key platform.Key, now time.Time) bool {
+	if key != platform.KeyUp && key != platform.KeyDown {
+		return false
+	}
+	*r = remoteRepeat{key: key, next: now.Add(remoteHoldDelay), fastAt: now.Add(remoteSpeedUpAfter)}
+	return true
+}
+
+func (r *remoteRepeat) end(key platform.Key) {
+	if r.key == key {
+		*r = remoteRepeat{}
+	}
+}
+
+func (r *remoteRepeat) poll(now time.Time) platform.Key {
+	if r.next.IsZero() || now.Before(r.next) {
+		return platform.KeyUnknown
+	}
+	interval := remoteRepeatFast
+	if now.Before(r.fastAt) {
+		interval = remoteRepeatSlow
+	}
+	// A late frame emits one step and restarts the interval from that frame.
+	r.next = now.Add(interval)
+	return r.key
+}
