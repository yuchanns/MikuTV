+func TestHeldVerticalRemotePressUsesDelayAndAccelerates(t *testing.T) {
+	start := time.Now()
+	var repeat remoteRepeat
+	if repeat.begin(platform.KeyLeft, start) || !repeat.begin(platform.KeyDown, start) {
+		t.Fatal("only vertical remote presses should repeat")
+	}
+	if got := repeat.poll(start.Add(remoteHoldDelay - time.Millisecond)); got != platform.KeyUnknown {
+		t.Fatalf("a tap repeated before the hold delay: %v", got)
+	}
+	first := start.Add(remoteHoldDelay)
+	if got := repeat.poll(first); got != platform.KeyDown || repeat.next.Sub(first) != remoteRepeatSlow {
+		t.Fatalf("first repeat has key %v and interval %v", got, repeat.next.Sub(first))
+	}
+	late := start.Add(2 * time.Second)
+	if got := repeat.poll(late); got != platform.KeyDown || repeat.next.Sub(late) != remoteRepeatFast {
+		t.Fatalf("steady repeat has key %v and interval %v", got, repeat.next.Sub(late))
+	}
+	if got := repeat.poll(late); got != platform.KeyUnknown {
+		t.Fatalf("late frame emitted multiple repeats: %v", got)
+	}
+	repeat.begin(platform.KeyUp, late)
+	repeat.end(platform.KeyDown)
+	if got := repeat.poll(late.Add(remoteHoldDelay)); got != platform.KeyUp {
+		t.Fatalf("new direction should win: %v", got)
+	}
+	repeat.end(platform.KeyUp)
+	if got := repeat.poll(late.Add(5 * time.Second)); got != platform.KeyUnknown {
+		t.Fatalf("release left a repeat scheduled: %v", got)
+	}
+}
