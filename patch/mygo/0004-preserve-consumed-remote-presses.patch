+
+func TestConsumedBackOwnsItsMatchingRelease(t *testing.T) {
+	presses := make(remotePresses)
+	if !presses.take(platform.KeyEscape, platform.KeyPressed, true) {
+		t.Fatal("consumed Back was forwarded to UIKit")
+	}
+	if presses.take(platform.KeyRight, platform.KeyReleased, false) {
+		t.Fatal("an unrelated release was consumed")
+	}
+	if !presses.take(platform.KeyEscape, platform.KeyReleased, false) {
+		t.Fatal("Back release was forwarded after its press was consumed")
+	}
+	if presses.take(platform.KeyEscape, platform.KeyReleased, false) {
+		t.Fatal("completed Back left a stale consumed press")
+	}
+	if presses.take(platform.KeyEscape, platform.KeyPressed, false) || presses.take(platform.KeyEscape, platform.KeyReleased, false) {
+		t.Fatal("unhandled root Back did not reach UIKit")
+	}
+}
