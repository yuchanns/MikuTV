+
+// A consumed press also owns its release, even when the press changed the view.
+type remotePresses map[platform.Key]bool
+
+func (p remotePresses) take(key platform.Key, kind platform.SurfaceEventKind, taken bool) bool {
+	switch kind {
+	case platform.KeyPressed:
+		if taken {
+			p[key] = true
+		}
+	case platform.KeyReleased:
+		taken = p[key] || taken
+		delete(p, key)
+	}
+	return taken
+}
