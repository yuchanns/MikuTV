+func (*window) SetTextInput(platform.TextInputState)      {}
+func (*window) UpdateAccessibility(*platform.AccessTree)  {}
+func (*window) StartDataDrag(platform.DragRequest)        {}
+func (*window) CancelDataDrag()                           {}
+func (*window) SetDropFormats([]transfer.Format)          {}
+func (*window) PlaceWebViews([]platform.WebViewPlacement) {}
+func (*window) NewWebView(*platform.WindowOptions, platform.WindowHandler) (platform.WebView, error) {
+	return nil, platform.ErrUnsupported
+}
+
+func (w *window) press(presses id, kind platform.SurfaceEventKind) bool {
+	handled := false
+	items := send(presses, "allObjects")
+	for index, count := uintptr(0), uintptr(send(items, "count")); index < count; index++ {
+		press := send(items, "objectAtIndex:", index)
+		key := remoteKey(int(send(press, "type")))
+		if key != platform.KeyUnknown {
+			handled = w.h.SurfaceEvent(platform.SurfaceEvent{Kind: kind, Key: key, PhysicalKey: key}) || handled
+		}
+	}
+	return handled
+}
