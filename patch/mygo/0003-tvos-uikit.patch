diff --git a/internal/tvos/app.go b/internal/tvos/app.go
new file mode 100644
index 0000000..1b12a76
--- /dev/null
+++ b/internal/tvos/app.go
@@ -0,0 +1,153 @@
+//go:build ios && tvos && arm64
+
+// Package tvos implements the single-window UIKit backend using Go and purego.
+package tvos
+
+import (
+	"fmt"
+	"log"
+	"os"
+	"unsafe"
+
+	"github.com/ebitengine/purego"
+	"github.com/ebitengine/purego/objc"
+	"github.com/egoist/mygo/internal/platform"
+	"github.com/egoist/mygo/internal/unsupported"
+)
+
+type Backend struct {
+	unsupported.Backend
+	h            platform.AppHandler
+	window       *window
+	loop, source uintptr
+	active       bool
+	loadErr      error
+}
+
+func New() *Backend                 { return &Backend{loadErr: load()} }
+func (*Backend) Name() string       { return "tvos/uikit" }
+func (*Backend) IsMainThread() bool { return native.mainThread == nil || native.mainThread() != 0 }
+
+func (b *Backend) Init(h platform.AppHandler, _ platform.AppOptions) error {
+	if b.loadErr != nil {
+		return b.loadErr
+	}
+	b.h = h
+	if err := b.registerClasses(); err != nil {
+		return fmt.Errorf("tvos: register classes: %w", err)
+	}
+	b.loop = native.mainLoop()
+	var context [10]uintptr
+	context[9] = purego.NewCallback(func(uintptr) { b.h.Dispatch() })
+	b.source = native.sourceCreate(0, 0, unsafe.Pointer(&context[0]))
+	if b.source == 0 {
+		return fmt.Errorf("tvos: create main run loop source")
+	}
+	native.addSource(b.loop, b.source, native.commonModes)
+	return nil
+}
+
+func (b *Backend) Run() error {
+	pool := native.poolPush()
+	defer native.poolPop(pool)
+	code := native.applicationMain(0, 0, 0, stringID("MyGoTVAppDelegate"))
+	return fmt.Errorf("tvos: UIApplicationMain returned %d", code)
+}
+
+// UIKit owns the application lifetime; an explicit App.Quit exits the process.
+func (*Backend) Quit() { os.Exit(0) }
+
+func (b *Backend) Signal() {
+	native.signalSource(b.source)
+	native.wakeLoop(b.loop)
+}
+
+func (b *Backend) Wake() { b.Signal() }
+func (*Backend) Step()   { native.runMode(native.defaultMode, 60, true) }
+
+func (b *Backend) registerClasses() error {
+	if err := register("MyGoTVAppDelegate", "UIResponder", []objc.MethodDef{
+		{Cmd: sel("application:didFinishLaunchingWithOptions:"), Fn: func(_ id, _ objc.SEL, app id, _ id) bool {
+			b.active = send(app, "applicationState") != 2
+			log.Print("mygo: tvos/uikit ready on main thread")
+			b.h.Ready()
+			return true
+		}},
+		{Cmd: sel("window"), Fn: func(id, objc.SEL) id {
+			if b.window != nil {
+				return b.window.native
+			}
+			return 0
+		}},
+		{Cmd: sel("applicationDidBecomeActive:"), Fn: func(id, objc.SEL, id) {
+			b.active = true
+			b.h.DidBecomeActive()
+			if b.window != nil {
+				b.window.h.Focused()
+				b.window.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceFocus})
+				b.window.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceShown})
+				b.window.RequestFrame()
+			}
+		}},
+		{Cmd: sel("applicationWillResignActive:"), Fn: func(id, objc.SEL, id) {
+			b.active = false
+			if b.window != nil {
+				send(b.window.link, "setPaused:", true)
+				b.window.h.Blurred()
+				b.window.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceBlur})
+				b.window.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceHidden})
+			}
+			b.h.DidResignActive()
+		}},
+		{Cmd: sel("applicationDidEnterBackground:"), Fn: func(id, objc.SEL, id) { b.h.PowerEvent("suspend") }},
+		{Cmd: sel("applicationWillEnterForeground:"), Fn: func(id, objc.SEL, id) { b.h.PowerEvent("resume") }},
+		{Cmd: sel("applicationWillTerminate:"), Fn: func(id, objc.SEL, id) { b.h.Terminating() }},
+	}); err != nil {
+		return err
+	}
+	if err := register("MyGoTVView", "UIView", []objc.MethodDef{
+		{Cmd: sel("canBecomeFirstResponder"), Fn: func(id, objc.SEL) bool { return true }},
+		{Cmd: sel("canBecomeFocused"), Fn: func(id, objc.SEL) bool { return true }},
+		{Cmd: sel("layoutSubviews"), Fn: func(self id, cmd objc.SEL) {
+			sendViewSuper(self, cmd)
+			if b.window != nil {
+				b.window.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceResize})
+				b.window.RequestFrame()
+			}
+		}},
+		{Cmd: sel("pressesBegan:withEvent:"), Fn: func(self id, cmd objc.SEL, presses, event id) {
+			if b.window == nil || !b.window.press(presses, platform.KeyPressed) {
+				sendViewSuper(self, cmd, presses, event)
+			}
+		}},
+		{Cmd: sel("pressesEnded:withEvent:"), Fn: func(self id, cmd objc.SEL, presses, event id) {
+			if b.window == nil || !b.window.press(presses, platform.KeyReleased) {
+				sendViewSuper(self, cmd, presses, event)
+			}
+		}},
+		{Cmd: sel("pressesCancelled:withEvent:"), Fn: func(self id, cmd objc.SEL, presses, event id) {
+			if b.window != nil {
+				b.window.press(presses, platform.KeyReleased)
+			}
+			sendViewSuper(self, cmd, presses, event)
+		}},
+	}); err != nil {
+		return err
+	}
+	return register("MyGoTVFrameTarget", "NSObject", []objc.MethodDef{
+		{Cmd: sel("displayFrame:"), Fn: func(id, objc.SEL, id) {
+			w := b.window
+			if w == nil {
+				return
+			}
+			send(w.link, "setPaused:", true)
+			if !b.active || !w.visible || !w.pending {
+				return
+			}
+			w.pending = false
+			if w.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceFrame, Paced: true}) {
+				w.RequestFrame()
+			}
+		}},
+	})
+}
