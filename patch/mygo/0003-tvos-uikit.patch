diff --git a/internal/tvos/objc.go b/internal/tvos/objc.go
new file mode 100644
index 0000000..d65692f
--- /dev/null
+++ b/internal/tvos/objc.go
@@ -0,0 +1,111 @@
+//go:build ios && tvos && arm64
+
+package tvos
+
+import (
+	"fmt"
+	"runtime"
+	"unsafe"
+
+	"github.com/ebitengine/purego"
+	"github.com/ebitengine/purego/objc"
+)
+
+type id = objc.ID
+type rect struct{ X, Y, Width, Height float64 }
+
+var native struct {
+	applicationMain func(int32, uintptr, id, id) int32
+	mainThread      func() int32
+	mainLoop        func() uintptr
+	sourceCreate    func(uintptr, int, unsafe.Pointer) uintptr
+	addSource       func(uintptr, uintptr, uintptr)
+	signalSource    func(uintptr)
+	wakeLoop        func(uintptr)
+	runMode         func(uintptr, float64, bool) int32
+	poolPush        func() uintptr
+	poolPop         func(uintptr)
+	getRect         func(id, objc.SEL) rect
+	initRect        func(id, objc.SEL, rect) id
+	commonModes     uintptr
+	defaultMode     uintptr
+	superSend       uintptr
+}
+
+func load() error {
+	libraries := make(map[string]uintptr)
+	for _, name := range []string{
+		"/usr/lib/libSystem.B.dylib", "/usr/lib/libobjc.A.dylib",
+		"/System/Library/Frameworks/Foundation.framework/Foundation",
+		"/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation",
+		"/System/Library/Frameworks/QuartzCore.framework/QuartzCore",
+		"/System/Library/Frameworks/UIKit.framework/UIKit",
+	} {
+		lib, err := purego.Dlopen(name, purego.RTLD_NOW|purego.RTLD_GLOBAL)
+		if err != nil {
+			return fmt.Errorf("tvos: load %s: %w", name, err)
+		}
+		libraries[name] = lib
+	}
+	cf := libraries["/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation"]
+	ui := libraries["/System/Library/Frameworks/UIKit.framework/UIKit"]
+	libobjc := libraries["/usr/lib/libobjc.A.dylib"]
+	var err error
+	native.superSend, err = purego.Dlsym(libobjc, "objc_msgSendSuper")
+	if err != nil {
+		return err
+	}
+	purego.RegisterLibFunc(&native.applicationMain, ui, "UIApplicationMain")
+	purego.RegisterLibFunc(&native.mainThread, libraries["/usr/lib/libSystem.B.dylib"], "pthread_main_np")
+	purego.RegisterLibFunc(&native.mainLoop, cf, "CFRunLoopGetMain")
+	purego.RegisterLibFunc(&native.sourceCreate, cf, "CFRunLoopSourceCreate")
+	purego.RegisterLibFunc(&native.addSource, cf, "CFRunLoopAddSource")
+	purego.RegisterLibFunc(&native.signalSource, cf, "CFRunLoopSourceSignal")
+	purego.RegisterLibFunc(&native.wakeLoop, cf, "CFRunLoopWakeUp")
+	purego.RegisterLibFunc(&native.runMode, cf, "CFRunLoopRunInMode")
+	purego.RegisterLibFunc(&native.poolPush, libobjc, "objc_autoreleasePoolPush")
+	purego.RegisterLibFunc(&native.poolPop, libobjc, "objc_autoreleasePoolPop")
+	purego.RegisterLibFunc(&native.getRect, libobjc, "objc_msgSend")
+	purego.RegisterLibFunc(&native.initRect, libobjc, "objc_msgSend")
+	for name, destination := range map[string]*uintptr{
+		"kCFRunLoopCommonModes": &native.commonModes, "kCFRunLoopDefaultMode": &native.defaultMode,
+	} {
+		address, err := purego.Dlsym(cf, name)
+		if err != nil {
+			return err
+		}
+		*destination = **(**uintptr)(unsafe.Pointer(&address))
+	}
+	return nil
+}
+
+func sel(name string) objc.SEL { return objc.RegisterName(name) }
+func class(name string) id     { return id(objc.GetClass(name)) }
+func alloc(name string) id     { return send(send(class(name), "alloc"), "init") }
+
+func send(object id, method string, args ...any) id {
+	return object.Send(sel(method), args...)
+}
+
+func stringID(value string) id {
+	return send(class("NSString"), "stringWithUTF8String:", value)
+}
+
+func register(name, superclass string, methods []objc.MethodDef) error {
+	_, err := objc.RegisterClass(name, objc.GetClass(superclass), nil, nil, methods)
+	return err
+}
+
+// sendViewSuper names the defined superclass, independent of runtime subclasses.
+func sendViewSuper(self id, command objc.SEL, values ...id) id {
+	context := struct{ receiver, superclass id }{self, class("UIView")}
+	var pin runtime.Pinner
+	pin.Pin(&context)
+	defer pin.Unpin()
+	args := []uintptr{uintptr(unsafe.Pointer(&context)), uintptr(command)}
+	for _, value := range values {
+		args = append(args, uintptr(value))
+	}
+	result, _, _ := purego.SyscallN(native.superSend, args...)
+	return id(result)
+}
