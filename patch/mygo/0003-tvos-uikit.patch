@@ -0,0 +1,22 @@
+package tvos
+
+import (
+	"testing"
+
+	"github.com/egoist/mygo/internal/platform"
+)
+
+func TestRemoteKeys(t *testing.T) {
+	for _, test := range []struct {
+		press int
+		key   platform.Key
+	}{
+		{0, platform.KeyUp}, {1, platform.KeyDown}, {2, platform.KeyLeft},
+		{3, platform.KeyRight}, {4, platform.KeyEnter}, {5, platform.KeyEscape},
+		{6, platform.KeySpace}, {-1, platform.KeyUnknown}, {7, platform.KeyUnknown},
+	} {
+		if got := remoteKey(test.press); got != test.key {
+			t.Errorf("remoteKey(%d) = %v, want %v", test.press, got, test.key)
+		}
+	}
+}
diff --git a/internal/tvos/window.go b/internal/tvos/window.go
new file mode 100644
index 0000000..69f03bb
--- /dev/null
+++ b/internal/tvos/window.go
@@ -0,0 +1,152 @@
+//go:build ios && tvos && arm64
+
+package tvos
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/ebitengine/purego/objc"
+	"github.com/egoist/mygo/internal/platform"
+	"github.com/egoist/mygo/transfer"
+)
+
+type window struct {
+	desktopWindow
+	b            *Backend
+	h            platform.WindowHandler
+	native, view id
+	link, target id
+	title        string
+	visible      bool
+	pending      bool
+	closed       bool
+}
+
+func (b *Backend) NewWindow(options *platform.WindowOptions, handler platform.WindowHandler) (platform.Window, error) {
+	if !options.Surface {
+		return nil, fmt.Errorf("tvos: only native UI windows are supported: %w", platform.ErrUnsupported)
+	}
+	if b.window != nil {
+		return nil, errors.New("tvos: only one fullscreen window is supported")
+	}
+	screen := send(class("UIScreen"), "mainScreen")
+	bounds := native.getRect(screen, sel("bounds"))
+	w := &window{b: b, h: handler, title: options.Title}
+	w.native = native.initRect(send(class("UIWindow"), "alloc"), sel("initWithFrame:"), bounds)
+	w.view = native.initRect(send(class("MyGoTVView"), "alloc"), sel("initWithFrame:"), rect{Width: bounds.Width, Height: bounds.Height})
+	controller := alloc("UIViewController")
+	send(controller, "setView:", w.view)
+	send(w.native, "setRootViewController:", controller)
+	send(controller, "release")
+	send(w.view, "release")
+	w.target = alloc("MyGoTVFrameTarget")
+	w.link = send(class("CADisplayLink"), "displayLinkWithTarget:selector:", w.target, sel("displayFrame:"))
+	send(w.link, "retain")
+	send(w.link, "setPaused:", true)
+	send(w.link, "addToRunLoop:forMode:", send(class("NSRunLoop"), "mainRunLoop"), native.commonModes)
+	b.window = w
+	return w, nil
+}
+
+func (w *window) Handle() uintptr           { return uintptr(w.native) }
+func (w *window) Surface() platform.Surface { return w }
+func (w *window) SetTitle(value string)     { w.title = value }
+func (w *window) Title() string             { return w.title }
+func (w *window) Bounds() platform.Rect {
+	width, height, _ := w.Size()
+	return platform.Rect{Width: int(width), Height: int(height)}
+}
+func (w *window) ContentBounds() platform.Rect { return w.Bounds() }
+func (w *window) IsVisible() bool              { return w.visible && !w.closed }
+func (w *window) IsFocused() bool              { return w.IsVisible() && w.b.active }
+
+func (w *window) Show() {
+	if w.closed {
+		return
+	}
+	w.visible = true
+	send(w.native, "makeKeyAndVisible")
+	send(w.view, "becomeFirstResponder")
+	w.h.Focused()
+	w.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceFocus})
+	w.RequestFrame()
+}
+
+func (w *window) ShowInactive() { w.Show() }
+func (w *window) Focus()        { w.Show() }
+func (w *window) Hide() {
+	w.visible = false
+	send(w.link, "setPaused:", true)
+	send(w.native, "setHidden:", true)
+	w.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceHidden})
+}
+
+func (w *window) Close() {
+	if w.closed {
+		return
+	}
+	w.closed, w.visible = true, false
+	w.b.window = nil
+	send(w.link, "invalidate")
+	// The content releases its renderer before the native layer is destroyed.
+	w.h.Closed()
+	send(w.native, "setHidden:", true)
+	send(w.link, "release")
+	send(w.target, "release")
+	send(w.native, "release")
+}
+
+func (w *window) Native() platform.SurfaceNative {
+	return platform.SurfaceNative{View: uintptr(w.view), Layer: uintptr(send(w.view, "layer"))}
+}
+
+func (w *window) Size() (width, height, scale float64) {
+	bounds := native.getRect(w.view, sel("bounds"))
+	screen := send(class("UIScreen"), "mainScreen")
+	scale = objc.Send[float64](screen, sel("scale"))
+	return bounds.Width, bounds.Height, scale
+}
+
+func (w *window) RequestFrame() {
+	w.pending = true
+	if w.b.active && w.IsVisible() {
+		send(w.link, "setPaused:", false)
+	}
+}
+
+func (*window) RefreshRate() float64 {
+	return float64(send(send(class("UIScreen"), "mainScreen"), "maximumFramesPerSecond"))
+}
