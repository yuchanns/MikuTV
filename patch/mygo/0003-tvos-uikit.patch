@@ -0,0 +1,25 @@
+package tvos
+
+import "github.com/egoist/mygo/internal/platform"
+
+// UIPressType values are stable public UIKit constants, independent of key codes.
+func remoteKey(press int) platform.Key {
+	switch press {
+	case 0:
+		return platform.KeyUp
+	case 1:
+		return platform.KeyDown
+	case 2:
+		return platform.KeyLeft
+	case 3:
+		return platform.KeyRight
+	case 4:
+		return platform.KeyEnter
+	case 5:
+		return platform.KeyEscape
+	case 6:
+		return platform.KeySpace
+	default:
+		return platform.KeyUnknown
+	}
+}
diff --git a/internal/tvos/remote_test.go b/internal/tvos/remote_test.go
new file mode 100644
