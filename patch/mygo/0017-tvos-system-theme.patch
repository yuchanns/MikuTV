diff --git a/internal/tvos/theme.go b/internal/tvos/theme.go
new file mode 100644
index 0000000..f84a91b
--- /dev/null
+++ b/internal/tvos/theme.go
@@ -0,0 +1,82 @@
+//go:build ios && tvos && arm64
+
+package tvos
+
+import "github.com/egoist/mygo/internal/platform"
+
+const (
+	uiUserInterfaceStyleUnspecified uintptr = 0
+	uiUserInterfaceStyleLight       uintptr = 1
+	uiUserInterfaceStyleDark        uintptr = 2
+)
+
+func (b *Backend) Theme() platform.Theme { return tvTheme{b: b} }
+
+type tvTheme struct{ b *Backend }
+
+func (t tvTheme) IsDark() bool {
+	switch t.b.themeSource {
+	case "light":
+		return false
+	case "dark":
+		return true
+	default:
+		return t.b.systemInterfaceStyle() != uiUserInterfaceStyleLight
+	}
+}
+
+func (t tvTheme) SetSource(source string) {
+	t.b.themeSource = source
+	t.b.applyWindowInterfaceStyle()
+}
+
+func (tvTheme) UIFont() string                        { return "" }
+func (tvTheme) FontRendering() platform.FontRendering { return platform.FontRendering{} }
+func (tvTheme) Preferences() platform.Preferences     { return platform.Preferences{} }
+
+func (b *Backend) systemInterfaceStyle() uintptr {
+	if screen := send(class("UIScreen"), "mainScreen"); screen != 0 {
+		if traits := send(screen, "traitCollection"); traits != 0 {
+			if style := uintptr(send(traits, "userInterfaceStyle")); style != uiUserInterfaceStyleUnspecified {
+				return style
+			}
+		}
+	}
+	if b.window != nil && b.window.view != 0 {
+		if traits := send(b.window.view, "traitCollection"); traits != 0 {
+			if style := uintptr(send(traits, "userInterfaceStyle")); style != uiUserInterfaceStyleUnspecified {
+				return style
+			}
+		}
+	}
+	return uiUserInterfaceStyleDark
+}
+
+func (b *Backend) syncSystemTheme() {
+	style := b.systemInterfaceStyle()
+	if !b.styleKnown {
+		b.styleKnown = true
+		b.lastStyle = style
+		return
+	}
+	if style != b.lastStyle {
+		b.lastStyle = style
+		if b.h != nil {
+			b.h.ThemeChanged()
+		}
+	}
+}
+
+func (b *Backend) applyWindowInterfaceStyle() {
+	if b.window == nil || b.window.native == 0 {
+		return
+	}
+	style := int(uiUserInterfaceStyleUnspecified)
+	switch b.themeSource {
+	case "light":
+		style = int(uiUserInterfaceStyleLight)
+	case "dark":
+		style = int(uiUserInterfaceStyleDark)
+	}
+	send(b.window.native, "setOverrideUserInterfaceStyle:", style)
+}
diff --git a/internal/tvos/window.go b/internal/tvos/window.go
index 6c9e241..d42f88c 100644
--- a/internal/tvos/window.go
+++ b/internal/tvos/window.go
@@ -52,6 +52,7 @@ func (b *Backend) NewWindow(options *platform.WindowOptions, handler platform.Wi
 	send(w.link, "setPaused:", true)
 	send(w.link, "addToRunLoop:forMode:", send(class("NSRunLoop"), "mainRunLoop"), native.commonModes)
 	b.window = w
+	b.applyWindowInterfaceStyle()
 	return w, nil
 }
 
