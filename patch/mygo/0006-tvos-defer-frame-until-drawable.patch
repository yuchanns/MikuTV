 }
 
+var _ platform.PacedSurface = (*window)(nil)
+
+// FrameNow finishes a display-link frame deferred by the renderer.
+func (w *window) FrameNow() { w.frame(false) }
+
+func (w *window) frame(paced bool) {
+	if !w.IsFocused() {
+		return
+	}
+	if w.h.SurfaceEvent(platform.SurfaceEvent{Kind: platform.SurfaceFrame, Paced: paced}) {
+		w.RequestFrame()
+	}
+}
+
 func (*window) RefreshRate() float64 {
 	return float64(send(send(class("UIScreen"), "mainScreen"), "maximumFramesPerSecond"))
 }
