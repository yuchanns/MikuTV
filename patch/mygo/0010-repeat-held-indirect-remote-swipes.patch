+func isRemoteDirection(key platform.Key) bool {
+	switch key {
+	case platform.KeyLeft, platform.KeyRight, platform.KeyUp, platform.KeyDown:
+		return true
+	default:
+		return false
+	}
+}
+
+type remotePan struct {
+	x, y    float64
+	started bool
+	key     platform.Key
+}
+
+func (p *remotePan) move(x, y float64) platform.Key {
+	if !p.started {
+		// Indirect pans may begin with an offset from the touch surface.
+		p.x, p.y, p.started = x, y, true
+		return platform.KeyUnknown
+	}
+	dx, dy := x-p.x, y-p.y
+	if p.key != platform.KeyUnknown || max(math.Abs(dx), math.Abs(dy)) < 4 {
+		return platform.KeyUnknown
+	}
+	p.key = panKey(dx, dy)
+	return p.key
+}
+
+type remoteInput uint8
+
+const (
+	remoteButton remoteInput = iota
+	remoteTouch
+)
+
 type remoteRepeat struct {
 	key          platform.Key
+	input        remoteInput
 	next, fastAt time.Time
 }
 
-func (r *remoteRepeat) begin(key platform.Key, now time.Time) bool {
+func (r *remoteRepeat) begin(key platform.Key, input remoteInput, now time.Time) bool {
-	if key != platform.KeyUp && key != platform.KeyDown {
+	if !isRemoteDirection(key) {
 		return false
 	}
-	*r = remoteRepeat{key: key, next: now.Add(remoteHoldDelay), fastAt: now.Add(remoteSpeedUpAfter)}
+	*r = remoteRepeat{key: key, input: input, next: now.Add(remoteHoldDelay), fastAt: now.Add(remoteSpeedUpAfter)}
 	return true
 }
 
-func (r *remoteRepeat) end(key platform.Key) {
-	if r.key == key {
+func (r *remoteRepeat) end(key platform.Key, input remoteInput) {
+	if r.key == key && r.input == input {
 		*r = remoteRepeat{}
 	}
 }
