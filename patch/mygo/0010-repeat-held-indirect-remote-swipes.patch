+func TestHorizontalRemotePressesRepeat(t *testing.T) {
+	var repeat remoteRepeat
+	start := time.Now()
+	for _, direction := range []platform.Key{platform.KeyLeft, platform.KeyRight} {
+		if !repeat.begin(direction, remoteButton, start) || repeat.poll(start.Add(remoteHoldDelay)) != direction {
+			t.Fatalf("holding %v did not repeat", direction)
+		}
+		repeat.end(direction, remoteButton)
+	}
+}
+
+func TestRemotePanUsesMovementAfterTheStartingOffset(t *testing.T) {
+	var pan remotePan
+	if pan.move(-1350, 0) != platform.KeyUnknown || pan.move(-1348, 1) != platform.KeyUnknown {
+		t.Fatal("the starting offset or small drift produced a key")
+	}
+	if got := pan.move(-1290, 2); got != platform.KeyRight {
+		t.Fatalf("rightward movement after a negative offset produced %v", got)
+	}
+	if got := pan.move(-1500, 0); got != platform.KeyUnknown {
+		t.Fatalf("an active gesture emitted a second key: %v", got)
+	}
+}
+
+func TestTouchRemoteHoldKeepsItsOwnRelease(t *testing.T) {
+	var repeat remoteRepeat
+	start := time.Now()
+	repeat.begin(platform.KeyDown, remoteTouch, start)
+	repeat.end(platform.KeyDown, remoteButton)
+	if got := repeat.poll(start.Add(remoteHoldDelay)); got != platform.KeyDown {
+		t.Fatalf("a button release cancelled the held touch gesture: %v", got)
+	}
+	repeat.end(platform.KeyDown, remoteTouch)
+	if got := repeat.poll(start.Add(2 * time.Second)); got != platform.KeyUnknown {
+		t.Fatalf("releasing the held touch gesture left a repeat scheduled: %v", got)
 	}
