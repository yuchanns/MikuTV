+func (w *window) updateRemotePan(recognizer id) {
+	const ( // UIGestureRecognizerState values.
+		began     = 1
+		changed   = 2
+		ended     = 3
+		cancelled = 4
+		failed    = 5
+	)
+	state := send(recognizer, "state")
+	switch state {
+	case began, changed:
+		delta := native.panTranslation(recognizer, sel("translationInView:"), w.view)
+		if key := w.pan.move(delta.X, delta.Y); key != platform.KeyUnknown && w.sendRemoteKey(key, platform.KeyPressed) {
+			w.startRemoteRepeat(key, remoteTouch)
+		}
+	case ended, cancelled, failed:
+		key := w.pan.key
+		w.pan = remotePan{}
+		if key != platform.KeyUnknown {
+			w.repeat.end(key, remoteTouch)
+			w.sendRemoteKey(key, platform.KeyReleased)
+		} else if state == ended {
+			delta := native.panTranslation(recognizer, sel("translationInView:"), w.view)
+			if key := panKey(delta.X, delta.Y); key != platform.KeyUnknown {
+				w.sendRemoteKey(key, platform.KeyPressed)
+				w.sendRemoteKey(key, platform.KeyReleased)
+			}
+		}
+	}
+}
+
+func (w *window) startRemoteRepeat(key platform.Key, input remoteInput) {
+	if w.IsFocused() && w.repeat.begin(key, input, time.Now()) {
+		send(w.link, "setPaused:", false)
+	}
+}
+
 func (w *window) sendRemoteKey(key platform.Key, kind platform.SurfaceEventKind) bool {
 	return w.h.SurfaceEvent(platform.SurfaceEvent{Kind: kind, Key: key, PhysicalKey: key})
 }
