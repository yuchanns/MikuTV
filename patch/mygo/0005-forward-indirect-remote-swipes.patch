 }
+
+func TestRemotePanUsesItsDominantDirection(t *testing.T) {
+	for _, test := range []struct {
+		x, y float64
+		key  platform.Key
+	}{
+		{x: 42, y: 12, key: platform.KeyRight},
+		{x: -31, y: -8, key: platform.KeyLeft},
+		{x: 15, y: -39, key: platform.KeyUp},
+		{x: -6, y: 46, key: platform.KeyDown},
+		{key: platform.KeyUnknown},
+	} {
+		if got := panKey(test.x, test.y); got != test.key {
+			t.Errorf("panKey(%v, %v) = %v, want %v", test.x, test.y, got, test.key)
+		}
+	}
+}
