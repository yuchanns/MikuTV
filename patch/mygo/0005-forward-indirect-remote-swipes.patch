+func (w *window) installRemotePan() {
+	// The remote surface emits indirect touches independently of its buttons.
+	const indirectTouch = 1 // UITouchTypeIndirect
+	number := send(class("NSNumber"), "numberWithInteger:", indirectTouch)
+	recognizer := send(send(class("UIPanGestureRecognizer"), "alloc"), "initWithTarget:action:", w.view, sel("remotePan:"))
+	send(recognizer, "setAllowedTouchTypes:", send(class("NSArray"), "arrayWithObject:", number))
+	send(w.view, "addGestureRecognizer:", recognizer)
+	send(recognizer, "release")
+}
+
+func (w *window) sendRemoteKey(key platform.Key, kind platform.SurfaceEventKind) bool {
+	return w.h.SurfaceEvent(platform.SurfaceEvent{Kind: kind, Key: key, PhysicalKey: key})
+}
